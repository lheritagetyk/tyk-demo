							"const client_id = pm.environment.get('client_id') || 'my-tpp-public';",
							"",
							"// Build the authorization URL",
							"const authUrl = `${auth_server}/realms/${realm}/protocol/openid-connect/auth?client_id=${client_id}&request_uri=${encodeURIComponent(request_uri)}`;",
