			"value": "bank"
		},
		{
			"key": "client_id",
			"value": "bank-client"
		},
		{
			"key": "redirect_uri",
			"value": "https://oauth.pstmn.io/v1/callback"
		},
		{
			"key": "scope",
			"value": "openid accounts"
		}
	]
}