      "PageMetadata": {
        "description": "Offset IDs for paginated result sets",
        "properties": {
          "nextOffset": {
            "description": "Opaque identifier. Does not need to be numeric or have any specific pattern. Implementation specific",
            "example": "2",
            "type": "string"
          },
          "prevOffset": {
            "description": "Opaque identifier. Does not need to be numeric or have any specific pattern. Implementation specific",
            "example": "1",
            "type": "string"
          },
          "totalElements": {
            "description": "Total number of elements",
            "example": 3,
            "type": "integer"
          }
        },
        "title": "Page Metadata",
        "type": "object"
      },
      "PageMetadataLinks": {
        "description": "Resource URLs for retrieving next or previous datasets",
        "properties": {
          "next": {
            "$ref": "#/components/schemas/HateoasLink"
          },
          "prev": {
            "$ref": "#/components/schemas/HateoasLink"
          }
        },
        "title": "Page Metadata Links",
        "type": "object"
      },
      "Person": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Contacts"
          },
          {
            "properties": {
              "dateOfBirth": {
                "$ref": "#/components/schemas/DateString"
              },
              "governmentId": {
                "description": "A federal (such as passport) or state (such as driver's license) issued identifier",
                "type": "string"
              },
