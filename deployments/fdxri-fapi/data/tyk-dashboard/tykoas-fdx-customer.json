{
  "info": {
    "contact": {
      "email": "fdxsupport@financialdataexchange.org",
      "name": "Financial Data Exchange",
      "url": "https://financialdataexchange.org/"
    },
    "description": "Financial Data Exchange V6.2.0 Customer API",
    "license": {
      "name": "FDX API License Agreement (11-13-2019)",
      "url": "https://financialdataexchange.org/common/Uploaded%20files/Policies/FDX%20API%20License%20Agreement-(11-13-2019).pdf"
    },
    "title": "FDX V6.2.0 Customer API",
    "version": "6.2.0"
  },
  "openapi": "3.0.3",
  "servers": [
    {
      "url": "http://localhost:8080/fdx"
    },
    {
      "description": "Financial Data Exchange V6 Customer API",
      "url": "http://host.docker.internal:8090/fdxapi"
    }
  ],
  "tags": [
    {
      "description": "Search and view customer or customers",
      "name": "Personal Information"
    }
  ],
  "security": [
    {
      "jwtAuth": []
    }
  ],
  "paths": {
    "/customers": {
      "get": {
        "description": "Retrieve account holders related to permissioned accounts",
        "operationId": "getCustomers",
        "parameters": [
          {
            "$ref": "#/components/parameters/OffsetQuery"
          },
          {
            "$ref": "#/components/parameters/LimitQuery"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customers"
                }
              }
            },
            "description": "Customers",
            "headers": {
              "x-fapi-interaction-id": {
                "$ref": "#/components/headers/x-fapi-interaction-id"
              }
            }
          }
        },
        "summary": "Retrieve customers",
        "tags": [
          "Personal Information"
        ]
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/FapiInteractionIdHeader"
        },
        {
          "$ref": "#/components/parameters/FdxApiActorTypeHeader"
        }
      ]
    },
    "/customers/current": {
      "get": {
        "description": "Get information about the customer within the authorization scope",
        "operationId": "getCustomerInfo",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            },
            "description": "Data describing current authenticated customer",
            "headers": {
              "x-fapi-interaction-id": {
                "$ref": "#/components/headers/x-fapi-interaction-id"
              }
            }
          }
        },
        "summary": "Get current authenticated customer information",
        "tags": [
          "Personal Information"
        ]
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/FapiInteractionIdHeader"
        },
        {
          "$ref": "#/components/parameters/FdxApiActorTypeHeader"
        }
      ]
    },
    "/customers/{customerId}": {
      "get": {
        "description": "Retrieve customer information by customer id",
        "operationId": "getCustomer",
        "parameters": [
          {
            "description": "Customer Identifier",
            "in": "path",
            "name": "customerId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            },
            "description": "Customer",
            "headers": {
              "x-fapi-interaction-id": {
                "$ref": "#/components/headers/x-fapi-interaction-id"
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "examples": {
                  "Customer not found": {
                    "value": {
                      "code": "601",
                      "debugMessage": "Provider custom developer-level error details for troubleshooting",
                      "message": "Customer not found"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Customer with id not found",
            "headers": {
              "x-fapi-interaction-id": {
                "$ref": "#/components/headers/x-fapi-interaction-id"
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "summary": "Customer by id",
        "tags": [
          "Personal Information"
        ]
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/FapiInteractionIdHeader"
        },
        {
          "$ref": "#/components/parameters/FdxApiActorTypeHeader"
        },
        {
          "in": "path",
          "name": "customerId",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    }
  },
  "components": {
    "schemas": {
      "AccountHolderRelationship": {
        "description": "Types of relationships between accounts and holders. Suggested values",
        "enum": [
          "AUTHORIZED_USER",
          "BUSINESS",
          "FOR_BENEFIT_OF",
          "FOR_BENEFIT_OF_PRIMARY",
          "FOR_BENEFIT_OF_PRIMARY_JOINT_RESTRICTED",
          "FOR_BENEFIT_OF_SECONDARY",
          "FOR_BENEFIT_OF_SECONDARY_JOINT_RESTRICTED",
          "FOR_BENEFIT_OF_SOLE_OWNER_RESTRICTED",
          "POWER_OF_ATTORNEY",
          "PRIMARY",
          "PRIMARY_BORROWER",
          "PRIMARY_JOINT",
          "PRIMARY_JOINT_TENANTS",
          "SECONDARY",
          "SECONDARY_BORROWER",
          "SECONDARY_JOINT",
          "SECONDARY_JOINT_TENANTS",
          "SOLE_OWNER",
          "TRUSTEE",
          "UNIFORM_TRANSFER_TO_MINOR"
        ],
        "title": "Account Holder Relationship",
        "type": "string"
      },
      "ActorType": {
        "description": "Indicates whether a customer is present and has requested the operation (USER), or if a batch job has requested the operation (BATCH)",
        "enum": [
          "BATCH",
          "USER"
        ],
        "title": "FDX API Actor Type",
        "type": "string"
      },
      "Address": {
        "description": "U.S. domestic address or a foreign address with country other than 'US'",
        "properties": {
          "city": {
            "$ref": "#/components/schemas/String64"
          },
          "country": {
            "$ref": "#/components/schemas/Iso3166CountryCode"
          },
          "line1": {
            "$ref": "#/components/schemas/String64"
          },
          "line2": {
            "$ref": "#/components/schemas/String64"
          },
          "line3": {
            "$ref": "#/components/schemas/String64"
          },
          "postalCode": {
            "description": "Postal code",
            "maxLength": 16,
            "type": "string"
          },
          "region": {
            "$ref": "#/components/schemas/String64"
          }
        },
        "title": "Address",
        "type": "object"
      },
      "BusinessCustomer": {
        "description": "Customers that are commercial in nature are affiliated with a business entity",
        "properties": {
          "domicile": {
            "$ref": "#/components/schemas/Domicile"
          },
          "industryCode": {
            "$ref": "#/components/schemas/IndustryCode"
          },
          "name": {
            "description": "Name of business customer",
            "type": "string"
          },
          "registeredAgents": {
            "description": "A list of registered agents who act on behalf of the business customer",
            "items": {
              "$ref": "#/components/schemas/CustomerName"
            },
            "type": "array"
          },
          "registeredId": {
            "description": "The registered tax identification number (TIN) or other identifier of business customer",
            "type": "string"
          }
        },
        "title": "Business Customer entity",
        "type": "object"
      },
      "BusinessOrConsumer": {
        "description": "Indicator if parent entity is a consumer or business",
        "enum": [
          "BUSINESS",
          "CONSUMER"
        ],
        "title": "Business or Consumer Type",
        "type": "string"
      },
      "Contacts": {
        "description": "Contains all contact details for individual or business",
        "properties": {
          "addresses": {
            "description": "Array of the contact physical addresses",
            "items": {
              "$ref": "#/components/schemas/DeliveryAddress"
            },
            "type": "array"
          },
          "emails": {
            "description": "Array of the contact email addresses",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "telephones": {
            "description": "Array of the contact telephone numbers",
            "items": {
              "$ref": "#/components/schemas/TelephoneNumber"
            },
            "type": "array"
          }
        },
        "title": "Contacts entity",
        "type": "object"
      },
      "ContentTypes": {
        "description": "Types of document formats. (Suggested values)",
        "enum": [
          "application/json",
          "application/pdf",
          "application/zip",
          "image/gif",
          "image/jpeg",
          "image/png",
          "image/tiff"
        ],
        "title": "Content Types",
        "type": "string"
      },
      "Customer": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Person"
          },
          {
            "properties": {
              "accounts": {
                "description": "List of accounts related to this customer",
                "items": {
                  "$ref": "#/components/schemas/CustomerToAccountRelationship"
                },
                "type": "array"
              },
              "businessCustomer": {
                "$ref": "#/components/schemas/BusinessCustomer"
              },
              "customerId": {
                "$ref": "#/components/schemas/Identifier"
              },
              "customerStartDate": {
                "$ref": "#/components/schemas/DateString"
              },
              "lastActivityDate": {
                "$ref": "#/components/schemas/DateString"
              },
              "name": {
                "$ref": "#/components/schemas/CustomerName"
              },
              "type": {
                "$ref": "#/components/schemas/BusinessOrConsumer"
              }
            },
            "type": "object"
          }
        ],
        "description": "Represents a customer",
        "title": "Customer entity",
        "type": "object"
      },
      "CustomerName": {
        "allOf": [
          {
            "$ref": "#/components/schemas/IndividualName"
          },
          {
            "properties": {
              "company": {
                "description": "Company name",
                "type": "string"
              },
              "prefix": {
                "description": "Name prefix, e.g. Mr.",
                "type": "string"
              }
            },
            "type": "object"
          }
        ],
        "description": "The name of an individual in their role as a customer",
        "title": "Customer Name entity",
        "type": "object"
      },
      "CustomerToAccountRelationship": {
        "description": "Describes an account related to a customer",
        "properties": {
          "accountId": {
            "$ref": "#/components/schemas/Identifier"
          },
          "links": {
            "$ref": "#/components/schemas/HateoasLinks"
          },
          "relationship": {
            "$ref": "#/components/schemas/AccountHolderRelationship"
          }
        },
        "title": "Customer to Account Relationship entity",
        "type": "object"
      },
      "Customers": {
        "description": "List of customers",
        "properties": {
          "customers": {
            "description": "Array of customers",
            "items": {
              "$ref": "#/components/schemas/Customer"
            },
            "type": "array"
          },
          "links": {
            "$ref": "#/components/schemas/PageMetadataLinks"
          },
          "page": {
            "$ref": "#/components/schemas/PageMetadata"
          }
        },
        "title": "Customers Entity",
        "type": "object"
      },
      "DateString": {
        "description": "ISO 8601 full-date in format 'YYYY-MM-DD' according to [IETF RFC 3339](https://datatracker.ietf.org/doc/html/rfc3339.html#section-5.6)",
        "example": "2021-07-15",
        "format": "date",
        "maxLength": 10,
        "title": "Date String",
        "type": "string"
      },
      "DeliveryAddress": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Address"
          },
          {
            "properties": {
              "type": {
                "$ref": "#/components/schemas/DeliveryAddressType"
              }
            },
            "type": "object"
          }
        ],
        "description": "A delivery address and its location type",
        "title": "Delivery Address",
        "type": "object"
      },
      "DeliveryAddressType": {
        "description": "The location type of an address",
        "enum": [
          "BUSINESS",
          "DELIVERY",
          "HOME",
          "MAILING"
        ],
        "title": "Delivery Address Type",
        "type": "string"
      },
      "Domicile": {
        "description": "Country and region of country for the legal jurisdiction of an entity",
        "properties": {
          "country": {
            "$ref": "#/components/schemas/Iso3166CountryCode"
          },
          "region": {
            "$ref": "#/components/schemas/String64"
          }
        },
        "title": "Domicile entity",
        "type": "object"
      },
      "Error": {
        "description": "An error entity which can be used at the API level for error responses or at the account level to indicate a problem specific to a particular account. See the error codes and descriptions defined in the latest FDX API Specification document, section 6.2 Errors",
        "properties": {
          "code": {
            "description": "Error code defined by FDX API Specification or Data Provider indicating the error situation which has occurred",
            "type": "string"
          },
          "debugMessage": {
            "description": "Message used to debug the root cause of the error. Contents should not be used in consumer's business logic. Can change at any time and should only be used for consumer to communicate with the data provider about an issue. Provider can include an error GUID in message for their use.",
            "type": "string"
          },
          "message": {
            "description": "End user displayable information which might help the customer diagnose an error",
            "type": "string"
          }
        },
        "title": "Error",
        "type": "object"
      },
      "FapiInteractionId": {
        "description": "Universally unique identifier for this interaction, used across all FDX API requests and responses",
        "example": "c770aef3-6784-41f7-8e0e-ff5f97bddb3a",
        "format": "uuid",
        "maxLength": 36,
        "minLength": 36,
        "title": "FAPI Interaction ID",
        "type": "string"
      },
      "HateoasLink": {
        "description": "REST application constraint (Hypermedia As The Engine Of Application State)",
        "properties": {
          "action": {
            "$ref": "#/components/schemas/HttpAction"
          },
          "href": {
            "description": "URL to invoke the action on the resource",
            "example": "https://api.fi.com/fdx/v4/accounts/12345",
            "format": "uri-reference",
            "type": "string"
          },
          "rel": {
            "description": "Relation of this link to its containing entity, as defined by and with many example relation values at [IETF RFC5988](https://datatracker.ietf.org/doc/html/rfc5988)",
            "type": "string"
          },
          "types": {
            "description": "Content-types that can be used in the Accept header",
            "items": {
              "$ref": "#/components/schemas/ContentTypes"
            },
            "type": "array"
          }
        },
        "required": [
          "href"
        ],
        "title": "HATEOAS Link",
        "type": "object"
      },
      "HateoasLinks": {
        "description": "Links relative to this containing entity",
        "items": {
          "$ref": "#/components/schemas/HateoasLink"
        },
        "title": "HATEOAS Links array",
        "type": "array"
      },
      "HttpAction": {
        "description": "HTTP Methods to use for requests",
        "enum": [
          "DELETE",
          "GET",
          "PATCH",
          "POST",
          "PUT"
        ],
        "title": "HTTP Action Type",
        "type": "string"
      },
      "Identifier": {
        "description": "Value for a unique identifier",
        "maxLength": 256,
        "title": "Identifier",
        "type": "string"
      },
      "IndividualName": {
        "description": "First name, middle initial, last name, suffix fields",
        "properties": {
          "first": {
            "description": "First name",
            "type": "string"
          },
          "last": {
            "description": "Last name",
            "type": "string"
          },
          "middle": {
            "description": "Middle initial",
            "type": "string"
          },
          "suffix": {
            "description": "Generational or academic suffix",
            "type": "string"
          }
        },
        "title": "Individual name",
        "type": "object"
      },
      "IndustryClassificationSystem": {
        "description": "The Industry Classification System containing the industry code for customer.\n\n  | Value | Description |\n  |-----|-----|\n  | BCLASS | [Bloomberg Classification System](https://www.bloomberg.com/professional/product/reference-data/) |\n  | BICS | [Bloomberg Industry Classification System](https://www.bloomberg.com/professional/product/reference-data/) |\n  | GICS | [Global Industry Classification System](https://www.msci.com/our-solutions/indexes/gics) |\n  | MOODYS | Moody's Industry Classification |\n  | NAICS | [North American Industry Classification System](https://www.naics.com) |\n  | OTHER | Any other set of industry classification codes |\n  | SIC | [Standard Industry Classification system](https://www.osha.gov/pls/imis/sicsearch.html) |",
        "enum": [
          "BCLASS",
          "BICS",
          "GICS",
          "MOODYS",
          "NAICS",
          "OTHER",
          "SIC"
        ],
        "title": "Industry Classification System",
        "type": "string"
      },
      "IndustryCode": {
        "description": "Industry code and type",
        "properties": {
          "code": {
            "description": "Code value",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/IndustryClassificationSystem"
          }
        },
        "title": "Industry code",
        "type": "object"
      },
      "Iso3166CountryCode": {
        "description": "ISO 3166-1 alpha-2 codes as of April 5, 2023, from officially assigned Country Codes on [ISO Online Browsing Platform](https://www.iso.org/obp/ui/). Change log is at [ISO 3166 Maintenance Agency](https://www.iso.org/fr/committee/48750.html?t=3V3rukDb61p05Wd6ojyTRvE0S3Yg_fZgUjrLjHWcd9-mDmTKHOGjbX3nEJ3SqHar&view=documents#section-isodocuments-top)",
